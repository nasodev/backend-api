# App
DEBUG=false

# Database
# For local development: postgresql://postgres:password@localhost:5432/backend_api
# For Docker (로컬): postgresql://postgres:password@postgres15:5432/backend_api
# For Docker (프로덕션): postgresql://postgres:password@postgres:5432/backend_api
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/backend_api

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:3000","https://blog.funq.kr","https://chat.funq.kr","https://calendar.funq.kr"]

# Firebase
GOOGLE_APPLICATION_CREDENTIALS=firebase/firebase-credentials.json

# Anthropic API (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Test Firebase (for scripts/get_test_token.py)
TEST_FIREBASE_API_KEY=your_firebase_web_api_key
TEST_FIREBASE_ID=test@example.com
TEST_FIREBASE_PASSWORD=your_test_password

# Docker specific (for development with docker-compose.yml)
DB_PASSWORD=postgres

# CCUsage Tracker
CCUSAGE_API_KEY=your-secret-api-key

# Blog
BLOG_ADMIN_UIDS=["your-firebase-uid"]
BLOG_IMAGE_DIR=data/blog-images

# Native comments: generate a dedicated stable random secret before enabling guests.
# Keep it private and stable; changing it resets IP-based throttle identities.
BLOG_COMMENT_HASH_SECRET=
# Trust X-Real-IP only from these direct reverse-proxy peers (JSON array).
# Production Docker example after verifying the gateway: ["127.0.0.0/8","::1/128","172.19.0.1/32"]
BLOG_COMMENT_TRUSTED_PROXY_NETWORKS=["127.0.0.0/8","::1/128"]
